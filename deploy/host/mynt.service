[Unit]
Description=Mynt MCP server (loopback only, behind Caddy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mynt
Group=mynt
EnvironmentFile=/etc/mynt/env
Environment=NODE_ENV=production HOST=127.0.0.1
WorkingDirectory=/opt/mynt/current
ExecStart=/usr/bin/node dist/index.js serve-http
Restart=on-failure
RestartSec=5
MemoryMax=512M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
